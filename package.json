{
  "name": "ezequias-portifolio",
  "private": true,
  "scripts": {
    "dev:next": "next dev",
    "dev:open": "wait-on http://localhost:3000 && start http://localhost:3000",
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:open\"",
    "build": "next build",
    "start": "next start",
    "export": "next build && next export",
    "predeploy": "npm run export",
    "deploy": "gh-pages -d out"
  },
  "dependencies": {
    "@chakra-ui/react": "^1.7.2",
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@vercel/analytics": "^2.0.1",
    "axios": "^0.25.0",
    "framer-motion": "^4",
    "next": "12.0.6",
    "react": "^17.0.2",
    "react-dom": "17.0.2",
    "react-responsive": "^9.0.0-beta.5",
    "react-reveal": "^1.2.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "eslint": "8.4.0",
    "eslint-config-next": "12.0.6",
    "gh-pages": "^6.3.0",
    "open": "^11.0.4",
    "wait-on": "^9.5.1"
  }
}
